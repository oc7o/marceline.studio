{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@shared/*": ["../frontend/src/*"],
      "next/link": ["./src/runtime/next-link.tsx"],
      "next/navigation": ["./src/runtime/next-navigation.ts"],
      "next/headers": ["./src/runtime/next-headers.ts"],
      "next": ["./src/runtime/next.d.ts"],
      "server-only": ["./src/runtime/server-only.ts"],
      "*": ["./node_modules/@types/*", "./node_modules/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
