# Production customer cache (infra/prod/compose.yaml). Copy to infra/prod/.env on the host that
# runs the stack, chmod 600, and replace every value. Never commit the copy.
# `make prod-config` renders the compose file against THIS template, so every required key needs a
# (placeholder) value here. Django refuses to start with these placeholders (core/deploy.py).

# Public hostname and origin of the customer app (operator, 2026-09-17). Rehearsal on the
# development VPS: APP_DOMAIN=localhost, APP_ORIGIN=https://localhost:8443 (Caddy's internal CA;
# never public).
APP_DOMAIN=dash.marceline.studio
APP_ORIGIN=https://dash.marceline.studio

# Where Caddy publishes ports 80/443: the host's own **public IPv4** on the production VPS (e.g.
# CADDY_BIND=203.0.113.10), 127.0.0.1 for a rehearsal, with CADDY_HTTP_PORT=8480 and
# CADDY_HTTPS_PORT=8443 so the development stack is untouched. Never 0.0.0.0 — a docker-published
# port bypasses the host firewall, so a wildcard publishes the public edge on the tailnet too — and
# never the 100.x Tailscale address once PUBLIC_SITE=on: marceline.studio is live and promoted, and
# bound there it is reachable by nobody. `make prod-config` refuses both, and with PUBLIC_SITE=on it
# also refuses non-default ports here (Let's Encrypt validates on 80 and 443 only).
CADDY_BIND=127.0.0.1
CADDY_HTTP_PORT=
CADDY_HTTPS_PORT=
# Rehearsal on localhost: max-age=0, so a browser does not remember HSTS for localhost.
CADDY_HSTS=
# TLS issuer: `acme` (Let's Encrypt, needs 80/443 reachable from the internet) or `internal` (Caddy's
# own CA) while dash.marceline.studio points at production's Tailscale address and CADDY_BIND is
# that address. Switch to `acme` (and CADDY_BIND=<public IPv4>) at launch. It is **one variable for
# every site block** in the Caddyfile, so PUBLIC_SITE=on requires `acme`.
CADDY_TLS=acme
# The ACME account's contact address: the project mailbox, never a personal address (the same rule
# as the crawler's User-Agent). Let's Encrypt mails it when renewals keep failing. Required: with an
# empty value the Caddyfile does not adapt and the edge does not start, so compose refuses first.
# One account for both names once PUBLIC_SITE=on.
CADDY_ACME_EMAIL=contact@marceline.studio

# Which app answers /app (ADR 0036): `next` = the Next.js customer app in the `customer` container,
# `spa` = the Vite build baked into the Caddy image. `next` is phase 2; `spa` is the rollback, and
# switching is this value plus `docker compose up -d caddy` — no rebuild, no migration.
CUSTOMER_APP=next

# The public marketing site (website/), served by the same Caddy from static files (operator,
# 2026-09-18). `off` adds no site block at all — set it to `on` only once the DNS records for
# SITE_DOMAIN point at this host and website/README.md's "Before going live" list is empty, or
# Caddy will keep failing an ACME order for a name it cannot prove. Publishing an edit afterwards
# is an rsync of website/public plus `docker compose up -d caddy`; no rebuild, no migration.
# One Caddy serves both names from the cut-over on (operator, 2026-09-19): while this is `off`,
# marceline.studio is served by the standalone `marceline-site` project, which holds this host's
# ports 80/443. Turning it `on` is step 3 of docs/runbooks/production.md section 14, never on its
# own — the two processes cannot both bind the public address.
PUBLIC_SITE=off
SITE_DOMAIN=marceline.studio
# The www name redirects to the apex, so there is one URL per page and the canonical tags stay
# true. Its own variable because a Caddy placeholder cannot be nested inside another.
SITE_WWW_DOMAIN=www.marceline.studio
SITE_CANONICAL_ORIGIN=https://marceline.studio
# Where the site's files live on THIS host. The default is the checkout's own website/public,
# which is what a rehearsal on the development VPS serves. On the production VPS there is no
# checkout, so point it at the copy rsync put there: SITE_ROOT=/srv/marceline/site
SITE_ROOT=../../website/public

# Secrets. Generate on the host, keep a copy in the password manager, never reuse the
# development values:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"   # DJANGO_SECRET_KEY
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"   # POSTGRES_PASSWORD
DJANGO_SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me

# The read-through cache (ADR 0028, runbook "Data").
# Development's export listener, by its Tailscale 100.x address (containers do not resolve
# MagicDNS names). Rehearsal on the development VPS: its Tailscale address as well.
CACHE_EXPORT_BASE_URL=http://100.64.0.1:8010
# From `manage.py create_service_token --name prod-YYYY-MM` on development. Shown once.
CACHE_EXPORT_TOKEN=change-me
# Development's PUBLIC key (the output of `manage.py generate_signing_key` on development), as a
# file on this host, e.g. /srv/marceline/keys/dev-signing.pub. Never the private key.
CACHE_VERIFY_KEY_FILE=./keys/dev-signing.pub
# The purge site: this host's Tailscale address (`tailscale ip -4`). Never 0.0.0.0 and never the
# public address — `make prod-config` accepts only a tailnet address (100.64.0.0/10,
# fd7a:115c:a1e0::/48) or loopback. Rehearsal: 127.0.0.1 with PURGE_PORT=8481.
TAILSCALE_BIND=127.0.0.1
PURGE_PORT=
# The host name development uses in CACHE_PURGE_BASE_URL (normally the same 100.x address).
PURGE_HOST=100.64.0.2

# Customer writes (ADR 0028 amendment "The production write path", runbook "Customer writes").
# true: "Add original" and client events are accepted into the outbox and development pulls them.
OUTBOX_ENABLED=false
# Production's OWN outbox signing key (`manage.py generate_signing_key` on this host, 0600), e.g.
# /srv/marceline/keys/prod-outbox.key. Mounted into `internal` only. Its public key goes to
# development's OUTBOX_VERIFY_KEY_FILE. Never development's key.
OUTBOX_SIGNING_KEY_FILE=./keys/prod-outbox.key
# A write still pending after this many hours is reported to Sentry; after this many hours without
# a pull from development new writes answer 503 `processing_paused`. Operator decision 2026-09-17.
OUTBOX_STALE_ALERT_HOURS=0.5
OUTBOX_PAUSE_AFTER_HOURS=6

# Cloud fingerprinting as a streaming relay (issue #59, ADR 0044 §9 and its amendment of
# 2026-09-19, runbook section 13). BOTH must be true for an upload route to answer here, and `web`
# refuses to start with the flag on and relay mode off — this host never stores a customer's file.
# Do not set either before the ADR amendment's preconditions are met: the published website
# claim ("Dein Video bleibt bei dir") must change in the same step (issue #124, and
# `make website-check` fails while it has not).
CLOUD_FINGERPRINTING_ENABLED=false
CLOUD_UPLOAD_RELAY_MODE=false
# Development's Tailscale-only listener (its 100.x address; MagicDNS names do not resolve in the
# container) — the same process that serves the export API, on its own path prefix.
CLOUD_RELAY_BASE_URL=
# The relay's own credential: `manage.py create_service_token --name prod-relay-2026-09
# --scope upload_relay` on development, printed once. NEVER the export token, and never a database
# role. Held by `web` only.
CLOUD_RELAY_TOKEN=

# Onboarding by invite (issue #115, ADR 0052 §9). true: a creator can redeem a staff-issued invite
# link on this host. It needs OUTBOX_ENABLED=true — the last step creates nothing here, it hands the
# redemption to the outbox and development makes the account, which appears here with the next
# `pull_accounts`. Off means every /api/v1/app/invite route answers the one neutral 404.
ONBOARDING_INVITES_ENABLED=false
# The documents the redemption presents, `id:version:sha256:url` per document, comma separated —
# the SAME published versions and digests as development's ONBOARDING_DOCUMENTS. Empty refuses the
# accept step, which is the default and the gate that keeps the flow behind the legal review.
ONBOARDING_DOCUMENTS=
# Proof of control of the creator's platform account (ADR 0055). The status read comes out of the
# signed bundle and the two writes go into the outbox, so this host may run it — but only with the
# same value set on development, which is where a code is generated and where staff look at the
# profile by hand. Off = the step answers 404 here.
ACCOUNT_CONTROL_VERIFICATION_ENABLED=false
# The creator's own data requests (ADR 0056, issue #133). This host is the reason the feature exists:
# the export download is development-only, so a creator who only ever sees this app could ask for
# neither a copy of their data nor its deletion. The status read comes out of the signed bundle and
# both writes go into the outbox, so set the same value on development — where the request is written
# and where a person answers it. Off = the screen says the step is not switched on.
CUSTOMER_DATA_REQUESTS_ENABLED=false

# Address verification and password reset (ADR 0054, issue #149). true: a creator can ask for a reset
# link here and set a new password here. Nothing is mailed from this host — there is no transport and
# `make prod-config` refuses one — so it needs OUTBOX_ENABLED=true: the request and the new password's
# **hash** go into the outbox and development does the rest. There is deliberately no EMAIL_* key in
# this file.
ACCOUNT_EMAIL_FLOWS_ENABLED=false
# How long each mailed link works. They are here because the screens on this host say the same
# numbers development's mails do, so the two must not drift; development holds the same two keys.
# Empty means the compose defaults (60 minutes and 48 hours), which is what these are.
ACCOUNT_PASSWORD_RESET_TTL_MINUTES=60
ACCOUNT_VERIFICATION_TTL_HOURS=48

# Image tag deployed (the git commit, e.g. `git rev-parse --short HEAD`); also Sentry's release.
MARCELINE_RELEASE=

# Error reporting (ADR 0028): a DSN from a Sentry project in the EU data region (ingest host
# *.de.sentry.io; anything else refuses to start). sentry-sdk ships in the image. Empty = off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=prod
