# The standalone edge for the public marketing site (infra/prod/site/compose.yaml).
# Copy to infra/prod/site/.env on the host that serves it, chmod 600, replace every value.
# Never commit the copy. There is no secret in this file — but it names addresses, so it is
# treated like the other one.
#
# `make prod-config` renders the compose file against THIS template, so every required key needs a
# (placeholder) value here.

# The host's PUBLIC address. Never 0.0.0.0 (a docker-published port bypasses the host firewall,
# so a wildcard publishes on the tailnet as well) and never the Tailscale address (100.64.0.0/10):
# infra/prod/site/check_config.py refuses both. The placeholder below is documentation-only
# (RFC 5737 TEST-NET-3); put this host's own address in the copy.
SITE_BIND=203.0.113.10
# Only with compose.ipv6.yaml, and only once marceline.studio and www have an AAAA record — the
# live deploy is IPv4-only today (2026-09-18), so this stays commented out until that record
# exists and compose.ipv6.yaml is added as a second -f file to every command against this
# project. Placeholder if uncommented: RFC 3849 documentation prefix.
# SITE_BIND6=2001:db8::10

# The names. The apex is canonical; www redirects to it with the path kept.
SITE_DOMAIN=marceline.studio
SITE_WWW_DOMAIN=www.marceline.studio
SITE_CANONICAL_ORIGIN=https://marceline.studio

# The ACME account's contact address: the project mailbox, never a personal address (CLAUDE.md,
# "Crawler User-Agent carries no contact data" applies to every outward identifier we publish).
# Let's Encrypt mails it when renewals keep failing.
SITE_ACME_EMAIL=contact@marceline.studio

# Where the site's files live on THIS host. The default is the checkout's own website/public,
# which is what a rehearsal on a development machine serves. On the production VPS there is no
# checkout, so point it at the copy rsync put there.
SITE_ROOT=/srv/marceline/site

# Which Caddy image to run. No default: it must be a tag the host already holds, because nothing
# is built or pulled there. Use the tag the customer stack runs — `docker compose -f
# /srv/marceline/infra/prod/compose.yaml ps` prints it, and it is MARCELINE_RELEASE in that
# project's .env. Placeholder only; replace it.
SITE_IMAGE_TAG=0000000

# HSTS. The default (a year, including subdomains) is right for a public name; set max-age=0 for
# a rehearsal on a name a browser should not remember.
CADDY_HSTS=
