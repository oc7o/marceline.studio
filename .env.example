# Copy to .env and adjust. .env is never committed.

# dev = local defaults (DEBUG on, insecure secret key); prod = every secret required
DJANGO_ENV=dev
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Address compose publishes the web port on. Keep 127.0.0.1, or use a private VPN address
# (e.g. the Tailscale IP) and add its hostnames to DJANGO_ALLOWED_HOSTS. Never 0.0.0.0.
WEB_BIND=127.0.0.1

# The customer app's dev server (`make customer-dev`, ADR 0035) calls Django here. Defaults to
# http://${WEB_BIND}:8000, which is what `make up` publishes; set it only if Django is elsewhere.
# CUSTOMER_DJANGO_BASE_URL=http://127.0.0.1:8000

# Postgres (compose publishes it on 127.0.0.1:${POSTGRES_PORT})
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=marceline
POSTGRES_USER=marceline
POSTGRES_PASSWORD=marceline

# Crawler User-Agent (product token only; no contact address during development)
CRAWLER_USER_AGENT=MarcelineBot/0.1
# Hoster intelligence (ADR 0027): days before a hosting record is looked up again.
# HOSTING_REFRESH_DAYS=30
# Fewer observed notices to a provider than this and a customer reads "no response history yet".
# HOSTING_HISTORY_MIN_NOTICES=5
# Provider directory: days before a verified complaint channel is due to be checked again.
# PROVIDER_CHANNEL_RECHECK_DAYS=90

# Customer case file (ADR 0025): reconcile an original's case whenever a customer reads it
# (default true). ADR 0028 turns it off where the API must not write on read; run
# `manage.py sync_cases` then to keep the stored cases current.
CASE_SYNC_ON_READ=true

# Unternehmer evidence at onboarding (issue #92). The pilot is B2B-only and EU-only.
# `accounts.BusinessStatus` records what staff checked;
# this decides what the admin does when a membership — the grant of customer access — is created
# without it. `warn` (default) shows a message and saves anyway; `refuse` rejects the save. The
# seeding commands (`seed_test_customer`, `seed_demo_dataset`) are never refused.
ONBOARDING_BUSINESS_STATUS_GUARD=warn

# Onboarding by invite (issue #115, ADR 0052). Staff issue a single-use link; the creator sets a
# password, signs the Unternehmer declaration, accepts the documents and answers the EU-only
# country question. This is NOT signup — a stranger still cannot create an account (ADR 0023).
# Off = every /api/v1/app/invite route answers one neutral 404 and the staff tooling refuses.
ONBOARDING_INVITES_ENABLED=false
# Proof of control of the creator's platform account (ADR 0055). We show the creator a one-time
# code, they put it in the bio of the account whose content we protect (or send it from there), and
# a staff member looks at that public profile BY HAND and ticks it off. Identity documents are
# never stored. Off = every /api/v1/app/verification route answers 404.
ACCOUNT_CONTROL_VERIFICATION_ENABLED=false
# The creator's own data requests (ADR 0056, issue #133): "send me an export" and "delete my data /
# end my pilot", both from inside the app and both on the public host. A request is recorded, dated
# and answered by a person — it exports nothing and deletes nothing, and the deletion clock is still
# a date a human sets with `end_pilot` (CUSTOMER_DATA_DELETION_ENABLED below guards the only code
# that deletes). Off = every /api/v1/app/data-requests route answers one plain 404.
CUSTOMER_DATA_REQUESTS_ENABLED=false
ONBOARDING_INVITE_EXPIRY_DAYS=14
# Where the customer app is reachable, so `manage.py invite_customer` can print a link. The
# operator sends it himself: no mail is sent by any code path. Since ADR 0052 §9 slice 2 the
# redemption works on the **public** host, so this is the public origin (https://dash.…), not a
# Tailscale address — otherwise the printed link goes nowhere for the creator who receives it.
ONBOARDING_INVITE_BASE_URL=
# Which documents a redemption presents: `id:version:sha256:url` entries separated by commas, the
# sha256 being that of the published text the URL resolves to. Ids: pilot_agreement,
# service_privacy_notice. EMPTY REFUSES, and empty is the default — the pilot agreement and the
# service privacy notice are unreviewed drafts, so no invite can be completed until the real
# documents are published. Do not fill this with a draft. It must hold the SAME versions and
# digests as infra/prod/.env: production accepts what it displays and development refuses a
# redemption whose documents are not the published ones (ADR 0052 amendment 2026-09-19).
ONBOARDING_DOCUMENTS=
# An invite that is never redeemed (expired, revoked, abandoned) held its
# personal data — email, note, declarations, country, a password hash until redemption — with no
# deletion clock. `invite_retention` deletes one this many days after it stopped being usable (the
# revocation timestamp for a revoked one, ONBOARDING_INVITE_EXPIRY_DAYS above for an expired one).
# A redeemed invite is never touched by this — it cascades away with its organisation. 30, like
# CUSTOMER_DATA_RETENTION_DAYS, until the pilot contract stack confirms it.
ONBOARDING_INVITE_RETENTION_DAYS=30
# OFF by default like PAGE_RETENTION_ENABLED below: deletion is irreversible, so the operator reads
# `invite_retention --dry-run` and turns this on once by hand.
INVITE_RETENTION_ENABLED=false

# Address verification and password reset (ADR 0054, issue #149). Both mails are sent by
# **development only**: the public host holds no transport, a request there goes into the outbox and
# this side issues the token and sends the mail. OFF by default, and with no EMAIL_HOST (or a local
# backend) nothing is issued either — a token nobody can receive is worse than a refusal. The link in
# each mail is built from ONBOARDING_INVITE_BASE_URL above, so that has to be the public origin.
ACCOUNT_EMAIL_FLOWS_ENABLED=false
# Envelope sender and reply address. Role addresses of ours, never a personal one (the same rule as
# the crawler's User-Agent). The mails name the reply address as the way to reach a human.
ACCOUNT_MAIL_FROM=noreply@marceline.studio
ACCOUNT_MAIL_REPLY_TO=contact@marceline.studio
# How long each link works. A reset is a credential in an inbox, so it is short; a verification is
# not urgent.
ACCOUNT_PASSWORD_RESET_TTL_MINUTES=60
ACCOUNT_VERIFICATION_TTL_HOURS=48

# Billing (ADR 0032): invoices + SEPA bank transfer. The seller's identity is printed on every
# invoice; set it only in the real .env, never in the repository. Issuing refuses while name,
# address, tax number or VAT ID, a valid IBAN or the small-business decision is missing.
BILLING_SELLER_NAME=
# Address lines separated by "|", e.g. Street 1|12345 City
BILLING_SELLER_ADDRESS=
BILLING_SELLER_TAX_NUMBER=
BILLING_SELLER_VAT_ID=
BILLING_SELLER_EMAIL=
BILLING_SELLER_IBAN=
BILLING_SELLER_BIC=
BILLING_SELLER_BANK=
# Small-business scheme (§ 19 UStG): true or false. No default on purpose — the operator sets it.
BILLING_SMALL_BUSINESS=
# Days to pay (default 14) and an optional number prefix such as RE- (fix it before the first invoice).
BILLING_PAYMENT_TERM_DAYS=
BILLING_INVOICE_NUMBER_PREFIX=

# Rights proof vault (ADR 0034): customer-uploaded contract excerpts, mandates and schedules,
# encrypted at rest. Development VPS only — never set these on the production cache.
# Comma-separated Fernet keys, the first encrypts, all decrypt (rotation). Generate one with
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep a copy of the key outside this machine: lose it and every stored proof is unreadable.
RIGHTS_VAULT_KEYS=
# Absolute directory OUTSIDE the repository, e.g. /var/lib/marceline/rights-vault (mode 700).
RIGHTS_VAULT_DIR=
# Largest accepted proof upload in bytes (default 10485760 = 10 MiB).
RIGHTS_PROOF_MAX_BYTES=

# Cloud fingerprinting (issue #59, ADR 0044): the customer uploads a video, the server hashes it
# and deletes the bytes. Development VPS only — the routes answer 404 on the production cache
# whatever is set here. OFF by default, and it must not be switched on for a real customer.
# Exercise it with the test customer instead.
CLOUD_FINGERPRINTING_ENABLED=
# Absolute directory OUTSIDE the repository for the upload spool, e.g.
# /var/lib/marceline/upload-spool (mode 700), on a volume that no backup script touches. Empty (the
# default) means no spool and every upload is refused. Put it on an encrypted filesystem: the file
# is in the clear on disk while it is being hashed (ADR 0044 §3).
CLOUD_UPLOAD_SPOOL_DIR=
# One upload chunk in bytes (default 8388608 = 8 MiB).
CLOUD_UPLOAD_CHUNK_BYTES=
# Largest single file in bytes (default 10737418240 = 10 GiB).
CLOUD_UPLOAD_MAX_BYTES=
# Largest total spool in bytes (default 42949672960 = 40 GiB); a new upload is refused above it.
CLOUD_UPLOAD_SPOOL_MAX_BYTES=
# Bytes one organisation may upload per rolling 24 h (default 64424509440 = 60 GiB).
CLOUD_UPLOAD_DAILY_BYTES_PER_ORG=
# Hard limit in hours on how long bytes may sit in the spool (default 6). The reaper deletes
# anything older whatever the database believes.
CLOUD_UPLOAD_TTL_HOURS=

# Notice drafts (issue #33, ADR 0035): customer-sent drafts only, nothing sent to a real recipient.
# A finding's availability check must be this recent to go into a draft (default 48).
NOTICE_AVAILABILITY_MAX_AGE_HOURS=
# Marceline-controlled test mailboxes only, comma-separated. Empty (the default) means the sandbox
# send path always refuses — never put a real recipient address here.
NOTICE_SANDBOX_RECIPIENTS=
# From-address for a sandbox draft's email copy; empty uses Django's default.
NOTICE_SANDBOX_FROM=

# Matching (ADR 0024): OpenMP threads per FAISS search (default 2; tiny batches always use 1).
# FAISS would otherwise take every core and starve the crawlers, media workers and Postgres.
MATCHING_FAISS_THREADS=
# Trim letterbox/pillarbox padding off page media before hashing (docs/matching/black-bars.md).
# OFF, and measured: 0 of 80 real page images carry a dark border, so this changes nothing today.
# It is also not retroactive — only media hashed after the switch gets de-barred hashes.
MATCHING_CROP_BLACK_BARS=false
# Frame embeddings, the second content signal (ADR 0037, docs/matching/embedding-pilot.md).
# OFF until the pilot's numbers are in. On, the crawl runtime's media lane also computes one
# 512-bit sketch (64 bytes) per frame beside its PDQ hash — a candidate generator, never evidence.
# It costs ~55 ms and ~160 MB of resident set per hashing process, and it is NOT retroactive:
# page pictures are discarded after hashing, so only media fetched afterwards has one.
# The model file is fetched once per machine (`manage.py fetch_embedding_model`, sha256-pinned)
# and never committed; leave the path empty for ~/.cache/marceline/models/.
MATCHING_EMBEDDINGS_ENABLED=false
MATCHING_EMBEDDING_MODEL_PATH=
MATCHING_EMBEDDING_TOP_K=10

# The reference-side crop grid (ADR 0039, docs/matching/reference-crop-grid.md).
# OFF until the pre-registered pilot's numbers are in. On, `match_references` also searches each
# grid moment's 16 corner crops and lets the moment's 8 KB blob decide, which recovers the 1-3 %
# asymmetric re-frame the sites apply (0.02 -> 0.95 of 3 % re-frames inside the threshold).
# Unlike the embedding it IS evidence, in PDQ's own units — and for the same reason adopting it
# means re-running `calibrate_confidence`: a minimum over 256 correlated hashes moves the whole
# distance distribution down 10-16 bits. Costs ~96 MB of matcher memory and 629 MB of blobs at
# today's 44 originals, and one full rescan the first time grids appear. The page side costs
# nothing: it is retroactive over every page hash already stored.
# The grids are produced on the operator's Mac (`client/fingerprint.py --crop-grid`) and import
# alongside the existing references under their own pipeline tag.
MATCHING_REFERENCE_CROP_GRID=false

# The third signal as an *aiming* signal (ADR 0040 and its 2026-09-18 amendment). Off, a page whose
# stored text is consistent with an original is reported by `manage.py metadata_candidates` and
# nothing else happens. On, that pair also becomes a browser-capture candidate (ADR 0016), after
# which PDQ decides by itself: a capture that matches becomes an ordinary match with real evidence
# frames, and one that does not lets the candidate die unseen. It never produces a review item and
# never produces a finding — the fields are the pirate site's own text, and a forged duration is
# cheap. Every ADR 0016 exclusion still applies, plus two of its own: the media gate must already
# allow the page, and the page must hold fewer than 10 frame hashes.
MATCHING_METADATA_CANDIDATES_ENABLED=false

# Sessions and CSRF (ADR 0023). The secure flags default to on when DJANGO_ENV=prod and off in dev;
# set them to 1 only if local development is served over HTTPS. Add every HTTPS origin the SPA is
# served from to the trusted origins (comma-separated, scheme included), e.g.
# https://dash.marceline.studio — Django refuses unsafe requests from an origin that is not listed.
SESSION_COOKIE_SECURE=
CSRF_COOKIE_SECURE=
SESSION_COOKIE_AGE_SECONDS=
DJANGO_CSRF_TRUSTED_ORIGINS=

# Login rate limiting and lockout (ADR 0023), shared by the staff and the customer login.
# Defaults: 5 failures per account and 20 per IP inside a 15-minute window, then 15 minutes of
# refusal counted from the last failure. `manage.py unlock_login --user NAME` lifts one by hand.
LOGIN_MAX_ACCOUNT_ATTEMPTS=
LOGIN_MAX_IP_ATTEMPTS=
LOGIN_ATTEMPT_WINDOW_MINUTES=
LOGIN_LOCKOUT_MINUTES=
# Number of reverse proxies in front of Django. 0 counts REMOTE_ADDR and ignores X-Forwarded-For;
# behind Caddy set 1 so the per-IP limit counts the visitor, not the proxy. A value higher than the
# real number of proxies lets a client forge its own address — never guess it upwards.
LOGIN_TRUSTED_PROXIES=
# What this process answers (ADR 0028): full = staff review API + admin + customer API (this
# development VPS, Tailscale only); customer = the public production cache, everything else 404.
# Empty = full in dev; production refuses to start until it is set explicitly.
DJANGO_PUBLIC_SURFACE=
# HTTPS hardening. Empty = on in DJANGO_ENV=prod (redirect, one-year HSTS incl. subdomains) and
# off in dev; production refuses to start with the redirect or HSTS turned off. Preload stays off
# unless the operator decides to commit the whole registrable domain.
SECURE_SSL_REDIRECT=
SECURE_HSTS_SECONDS=
SECURE_HSTS_INCLUDE_SUBDOMAINS=
SECURE_HSTS_PRELOAD=
# Error reporting (issue #37, ADR 0028, core/sentry.py). Off while empty. Sentry's EU data region
# only: a DSN whose ingest host does not end in .de.sentry.io refuses to start. `sentry-sdk` is a
# dependency. Never sent: PII, local variables, request bodies, cookies, headers, query strings,
# breadcrumb payloads; no tracing.
# All three reach `web`, the per-site crawlers and media workers, both crawl-runtime lanes, the
# scheduler and the export listener (`x-sentry-env` in infra/compose.yaml). A container
# keeps the environment it was created with, so after changing one recreate them: `make up`,
# `make workers`, `make runtime`. Production sets its own three in infra/prod/.env.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
MARCELINE_RELEASE=

# Production read-through cache (ADR 0028, docs/runbooks/production.md "Data"). This file is the
# development VPS: MARCELINE_ROLE stays dev (the default). Production's values live in
# infra/prod/.env. Everything here is empty/off until production exists.
# The `export` compose service (profile export): this VPS's Tailscale address, and the Ed25519
# private key from `manage.py generate_signing_key --private-key /srv/marceline/keys/dev-signing.key`
# (outside the repository, chmod 600; never committed, never copied to production).
EXPORT_BIND=
CACHE_SIGNING_KEY_FILE=
# Production's purge listener over Tailscale, e.g. http://100.64.0.2:8081 (the export service sends).
CACHE_PURGE_BASE_URL=
# The web process records purges (decisions, safety blocks) for the export service to send.
CACHE_PURGE_OUTBOX=false
# Customer writes accepted on production (ADR 0028 write-path amendment): production's PUBLIC
# outbox key (printed by `generate_signing_key` on production), e.g. /srv/marceline/keys/prod-outbox.pub.
# The export service verifies the batches `pull_customer_writes` fetches from CACHE_PURGE_BASE_URL.
OUTBOX_VERIFY_KEY_FILE=

# External APIs (needed from build step 3 on)
BRAVE_SEARCH_API_KEY=
ANTHROPIC_API_KEY=

# Source discovery (optional)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DISCOVERY_LOCATION_CODE=2840
DISCOVERY_LANGUAGE=en
DISCOVERY_MAX_CALLS_PER_RUN=60
DISCOVERY_DAILY_BUDGET_USD=0.25
# Issue #20: the scheduler's own periodic `discover_sources` run (propose-only, ADR 0013). OFF
# until the operator has turned it on by hand; when on it still goes through the same spend guard
# (DISCOVERY_MAX_CALLS_PER_RUN, DISCOVERY_DAILY_BUDGET_USD as a rolling 24h total) as a manual run.
DISCOVERY_SCHEDULE_ENABLED=false

# LLM extraction as repair when an adapter breaks (issue #22, ADR 0042). Off by default and
# **it costs money per call**: with CRAWLER_LLM_REPAIR_ENABLED=false nothing in the crawler ever
# contacts a model. It only ever runs for a site `manage.py adapter_health` has recorded broken,
# once per page, with no retry, and at most CRAWLER_LLM_REPAIR_DAILY_CALLS_PER_SITE calls per site
# per rolling 24 h — counted from the crawler.LLMCall rows, so a restart cannot reset it.
# Provider is OpenRouter (pay-per-use); pick the model yourself, there is no default.
CRAWLER_LLM_REPAIR_ENABLED=false
OPENROUTER_API_KEY=
CRAWLER_LLM_MODEL=
CRAWLER_LLM_REPAIR_DAILY_CALLS_PER_SITE=50

# Adapter breakage alert (issue #22): recorded when a site's parser is newly recorded broken.
# Falls back to SAFETY_ALERT_TO/SAFETY_ALERT_FROM when empty; off when neither pair is set. Folds
# into the daily report by default (OPERATOR_MAIL_IMMEDIATE below) rather than mailing on its own.
ADAPTER_ALERT_TO=
ADAPTER_ALERT_FROM=

# Operator mail consolidation (2026-09-19, core/operator_mail.py, docs/safety.md "Daily operator
# report"). An incident-rule block, a new/changed TDM/AI reservation (below) and a broken adapter
# (above) each used to mail the operator the moment they happened. All three now fold into the one
# daily report instead — still recorded and logged (Sentry sees it) exactly as before, just not
# mailed one by one. Comma list of kinds that should still mail immediately:
# safety_incident, tdm_reservation, adapter_health. Empty (the default) means none of them do.
OPERATOR_MAIL_IMMEDIATE=

# Targeted indexing (issue #71): the scheduler's `sync_targets` job deactivates pages of no target
# creator and reactivates pages of new targets. OFF until the operator has reviewed
# `deactivate_untargeted --dry-run` and applied it once by hand.
TARGETED_INDEXING_ENABLED=false
# Delete pages that stayed deactivated longer than 24 months (index.retention.PAGE_RETENTION_MONTHS,
# a code constant; ADR 0029 amendment).
# Irreversible: run `manage.py page_retention --dry-run` first. Off by default.
PAGE_RETENTION_ENABLED=false
# Prospect research: seed tasks per prospect per rolling 24 hours.
PROSPECT_DAILY_SEED_CAP=4

# Do-not-contact record (issue #98, ADR 0047): the key that every recorded
# "no" is hashed with, so the table holds no address, name or handle. Generate one with
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty = `manage.py may_contact` and the admin both refuse; nothing hashes with an empty key.
# NEVER ROTATE IT without a migration plan: the hashes are one-way, so a new key orphans every
# recorded objection and the check goes on answering "allowed" for people who said no. Keep a copy
# off this machine.
DO_NOT_CONTACT_HMAC_KEY=
# Safety incident retention (docs/safety.md, issue #100): the scheduler's `safety_retention` job
# closes a reported case the hotline never came back on after 90 days, then deletes a case closed
# longer than 12 months ago, with its URLs and any moved hashes. Both periods are code constants
# (index.incidents), matching the command's own default flags. Irreversible: run
# `manage.py safety_retention --dry-run` first. Off by default.
SAFETY_RETENTION_ENABLED=false

# Customer data deletion (ADR 0045, issue #85): the scheduler's `customer_data_retention` job
# deletes what an ended pilot, or one original marked for removal, left behind. OFF until the
# operator has read `customer_data_retention --dry-run`; the marks themselves are never guarded by
# it. Nothing is deleted for an organisation or an original nobody marked.
CUSTOMER_DATA_DELETION_ENABLED=false
# Days between the end of a pilot (or the removal of one original) and the deletion. 30 is the
# operator's promise of 2026-09-18; it is a setting so it can change.
CUSTOMER_DATA_RETENTION_DAYS=30

# Retention on the research side (ADR 0048, issues #103, #104): blank a discovery search query's
# text once it is past its period (the row itself is the search spend ledger and is never deleted),
# forget a prospect's research nobody acted on, and delete a catalogue name nothing uses any more.
# Irreversible: run `manage.py research_retention --dry-run` first. Off by default.
RESEARCH_RETENTION_ENABLED=false
# Days a search query's text is kept. It has no use once its candidates are recorded.
SEARCH_QUERY_RETENTION_DAYS=30
# Days a prospect's research is kept, from the day the watchlist entry was added.
PROSPECT_RESEARCH_RETENTION_DAYS=90
# Days a name is kept after the pass first saw nothing using it (no target role, no customer
# original, no watchlist entry, no active page, no safety record, no suppression, not in sources.md).
CREATOR_NAME_RETENTION_DAYS=90

# Dead media URL shapes (ADR 0042, issue #82). A site whose theme advertises a poster it never
# generated answers 404 for every page we index - site17.example spent 28 % of its media budget and
# 436 MB a day on that. The breaker stops fetching such a URL *shape* on that site and probes it
# once per backoff window, so a repaired theme is never locked out. OFF by default: the counters
# are kept either way, so `manage.py request_report` (or `media_shapes`) shows what it would
# suppress before it is given the budget. It only ever acts on 404/410 - never a 5xx, a 429, a 403,
# an expired CDN token, or anything refused before the request was sent.
MEDIA_URL_BREAKER_ENABLED=false
# Consecutive 404/410 answers, and the share of the shape's recent answers, both required.
MEDIA_SHAPE_GONE_STREAK=20
MEDIA_SHAPE_GONE_SHARE=0.70
MEDIA_SHAPE_WINDOW=100
# A streak whose last 404 is older than this starts again; suppression windows (hours).
MEDIA_SHAPE_STREAK_TTL_H=168
MEDIA_SHAPE_BACKOFF_H=6
MEDIA_SHAPE_MAX_BACKOFF_H=72
# How long one half-open probe holds the shape before the next claimant takes over (minutes).
MEDIA_SHAPE_PROBE_TIMEOUT_MIN=10

# Machine-readable TDM/AI reservations in robots.txt (issue #105). The crawler already fetches each site's robots.txt once per origin per 24 h; with
# detection on it also records what that file reserves and against whom (`catalog.SiteRobotsPolicy`,
# in `manage.py request_report`, the Site admin and `make status`) and mails the operator once per
# new or changed reservation. Tokens, booleans and a content hash - never a path or a line of the
# file, never an extra request. ON by default: it changes nothing about what is crawled.
ROBOTS_RESERVATION_DETECTION_ENABLED=true
# The automatic pause is OFF by default, because it does change what is crawled. With it on, a site
# whose robots.txt shuts our own user agent out of the whole host - or whose robots.txt response
# carries a TDM-Reservation / X-Robots-Tag: noai header - is paused for 30 days with pause_reason
# `tdm_reservation` and waits for the operator; a successful fetch never lifts that pause, unlike an
# outage one. A reservation addressed only to other companies' AI crawlers never pauses anything. A
# reservation naming `*` needs no pause - the ordinary robots.txt logic already skips every URL.
ROBOTS_RESERVATION_PAUSE_ENABLED=false

# Browser frame capture (ADR 0016, docs/safety.md). OFF by default, and deliberately so: one
# capture drives a real browser over a piracy page, the most expensive
# thing this system does. Enabling it is an operator decision per deployment. Triage
# (`triage_browser_capture`) keeps running either way; only `capture_worker` reads this flag.
BROWSER_CAPTURE_ENABLED=false
# Budgets count *visits*, not requests: one visit is 50-300 requests the browser makes by itself.
BROWSER_CAPTURE_PER_SITE_PER_DAY=5
BROWSER_CAPTURE_TOTAL_PER_DAY=20
# Daily window in UTC; may wrap midnight. Nothing is captured outside it.
BROWSER_CAPTURE_WINDOW_UTC=01:00-05:00
# Browsers at once. Keep it at 1: about one CPU core and 1.5 GB RSS each.
BROWSER_CAPTURE_MAX_CONCURRENCY=1
# Per-capture caps: frames sampled, seconds spent sampling, bytes pulled, and the visit watchdog.
BROWSER_CAPTURE_MAX_FRAMES=24
BROWSER_CAPTURE_MAX_SECONDS=120
BROWSER_CAPTURE_MAX_BYTES=209715200
BROWSER_CAPTURE_TIMEOUT_S=300
# Where Playwright is installed. Empty = frontend/parity/node_modules (frontend/parity/README.md);
# the backend itself has no browser dependency.
BROWSER_CAPTURE_NODE_MODULES=
# Browser engine: chromium (default: Playwright's headless shell), firefox or chrome
# (docs/research/browser-capture-no-video.md). BROWSER_CAPTURE_EXECUTABLE optionally points at the
# engine's binary, e.g. an unpacked Google Chrome.
BROWSER_CAPTURE_ENGINE=chromium
BROWSER_CAPTURE_EXECUTABLE=

# Safety mail (issue #40, docs/safety.md). Off unless BOTH are set — never commit a real address
# here. Same pair as the one daily operator report below; an incident-rule block also mails on its
# own only while OPERATOR_MAIL_IMMEDIATE names `safety_incident` (off by default, 2026-09-19).
SAFETY_ALERT_TO=
SAFETY_ALERT_FROM=
# Minutes between immediate alert mails, while `safety_incident` is in OPERATOR_MAIL_IMMEDIATE.
SAFETY_ALERT_INTERVAL_MINUTES=10
# UTC hour the scheduler mails the one daily operator report at (job `safety_digest`, once a day):
# safety (blocks, incident-rule blocks, what needs a human) and crawler (adapter alarms, TDM/AI
# reservations). Sent every day, even a fully quiet one — that is how the operator notices if the
# report itself stopped; `make status` shows when the job last ran either way.
SAFETY_DIGEST_HOUR_UTC=6
# Origin the moderation admin is reached at (e.g. https://dev.example.internal:8000), used only to
# build the admin link in the alert mail. Leave empty for a relative link.
SAFETY_ALERT_MODERATION_URL=
# Reply address in the hotline report draft (staff safety screen, docs/safety.md). A project role
# mailbox, never a personal address; empty leaves it out of the draft.
SAFETY_REPORT_REPLY_TO=reporting@marceline.studio

# Catalogue share (issue #107, ADR 0049): the
# percentage of a site's own catalogue we may hold, counting every page ever indexed, before the
# scheduler's `catalogue_share` job mails the operator once — through SAFETY_ALERT_TO above.
# **Monitoring only**: crossing it pauses nothing, disables nothing and slows nothing down.
# 0 switches the alert off.
CATALOGUE_SHARE_ALERT_PERCENT=25

# Outgoing mail (used only by the safety alert above today). Leave empty for the dev console
# backend (no network connection). Set these once a mailbox exists — never commit
# real credentials.
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
EMAIL_USE_SSL=
# Seconds before a mail server that does not answer is given up on (default 10; ignored by the
# console backend). Keeps a hung SMTP server from stalling the worker that sends an alert.
EMAIL_TIMEOUT=

# The deletion journal (ADR 0057, DPIA R24, issues #137 / #140 D3). A directory of append-only
# `<segment>.jsonl` files holding one line per irreversible privacy action — kind, a stable key
# (a row id, a keyed digest, a sha256), timestamp, never the deleted content and never a name. It
# lives **outside the database** so a restore cannot roll it back, and next to the dumps so
# `backup-run.sh` pushes it off-host under its own restic tag; after a restore
# `manage.py reapply_deletions` replays it (docs/runbooks/backup-restore.md § C).
#
# Empty = the journal is off: every deletion still happens, logs one CRITICAL line saying it will
# not survive a restore, and `reapply_deletions` refuses. Set it. The directory must exist and be
# writable by the operator; `infra/compose.yaml` mounts it into `web` and `scheduler` at this same
# path, so one value is both the host path and the container path.
#
#   mkdir -p ~/backups/marceline/journal && chmod 700 ~/backups/marceline/journal
DELETION_JOURNAL_DIR=
# Which file in that directory this process appends to (default `deletions`). The containers set
# their own (`web`, `scheduler`); a host-run command has no reason to change it. One shared file
# cannot work: the commands write as the operator, the containers as root.
DELETION_JOURNAL_SEGMENT=

# Backups (issue #39, docs/runbooks/backup-restore.md). The nightly dump is local and needs none
# of this; these variables switch on the encrypted off-host copy and the failure alert.
# A dump contains flagged URLs and safety records, so the repository password is the only thing
# standing between that and whoever can read the Storage Box. Never commit a real value here.

# restic repository, e.g. sftp:marceline-storagebox:/home/marceline (an ~/.ssh/config alias) or
# sftp:u123456@u123456.your-storagebox.de:/home/marceline. The path is absolute on the Storage Box
# and its SFTP login directory is /home, so it is /home/marceline, NOT /marceline. Never put the
# port in the URL — BACKUP_SSH_PORT carries it, and a port here becomes a path segment instead
# (docs/runbooks/backup-restore.md, step 4). Empty = no off-host copy: `make backup` then writes
# only to this machine and says so.
RESTIC_REPOSITORY=
# File holding the repository password, mode 600, OUTSIDE the repository and outside the backup
# directory (e.g. ~/.config/marceline/restic-password). Preferred over RESTIC_PASSWORD, which
# would put the password itself into .env. Lose this and every snapshot is unreadable.
RESTIC_PASSWORD_FILE=
RESTIC_PASSWORD_COMMAND=
RESTIC_PASSWORD=
# Only needed when the Storage Box is not reached through an ~/.ssh/config alias.
# Key path (never the key itself) and SSH port (Hetzner Storage Boxes use 23; default 23).
BACKUP_SSH_KEY=
BACKUP_SSH_PORT=
# Snapshot retention on the Storage Box (defaults: 3 / 7 / 4 / 6). Snapshots are pruned, not only
# forgotten — a deleted safety record must not live off-host forever (issue #66).
RESTIC_KEEP_LAST=
RESTIC_KEEP_DAILY=
RESTIC_KEEP_WEEKLY=
RESTIC_KEEP_MONTHLY=

# Backup alert: mailed when a run fails and when a run has not happened for too long. Falls back
# to SAFETY_ALERT_TO/SAFETY_ALERT_FROM when empty; off when neither pair is set. Uses the EMAIL_*
# mailer above.
BACKUP_ALERT_TO=
BACKUP_ALERT_FROM=
# Watchdog limits in hours (defaults: 36 local dump and run, 36 off-host copy, 240 restore check)
# and how often the same overdue warning may repeat (default 24).
BACKUP_MAX_AGE_HOURS=
OFFHOST_MAX_AGE_HOURS=
RESTORE_CHECK_MAX_AGE_HOURS=
BACKUP_ALERT_REPEAT_HOURS=
# Refuse to push a dump larger than this many MB (default 2048): the database holds URLs, hashes
# and metadata only, so an enormous dump means media got in — a bug, never something to ship.
MAX_DUMP_MB=

# Curated ~/.claude snapshot, riding along in the same backup-run.sh (issue: survivable agent
# memory; docs/runbooks/claude-home-restore.md). Only memory notes and the operator's own
# configuration — never credentials. Empty/default is right for the normal case; CLAUDE_HOME_DIR
# is only for pointing the script at a fixture directory in tests.
CLAUDE_HOME_DIR=
# Local copies to keep (default 5); long-term retention is off-host, same RESTIC_KEEP_* as above.
CLAUDE_HOME_KEEP_LOCAL=
# Refuse to build a snapshot larger than this many MB (default 300): memory notes and small
# config files should be tens of KB to a few MB; this size means the allowlist swept in something
# unexpected. Run `infra/backup/claude-home-backup.sh --dry-run` and check the listing first.
CLAUDE_HOME_MAX_MB=
# Watchdog limit in hours for the local snapshot's age (default 36, same default as the others).
CLAUDE_HOME_MAX_AGE_HOURS=
# Off by default (judgement call, docs/runbooks/claude-home-restore.md): also carry session
# transcripts (projects/*/*.jsonl). They are the only record of *why* many decisions were made,
# but they are large and hold everything ever discussed, unfiltered. Set to 1 to include them.
CLAUDE_HOME_INCLUDE_TRANSCRIPTS=
